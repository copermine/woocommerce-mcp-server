# Store credentials; never commit real values.
WORDPRESS_SITE_URL=https://your-shop.example
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me

# Public origin WITHOUT /mcp. Optional when RAILWAY_PUBLIC_DOMAIN is available.
PUBLIC_URL=https://your-service.up.railway.app
PORT=3000

# Auth0 example. Copy issuer EXACTLY from its discovery document.
OAUTH_ISSUER=https://your-tenant.eu.auth0.com/
OAUTH_JWKS_URL=https://your-tenant.eu.auth0.com/.well-known/jwks.json
# Auth0 User ID (sub), not email; comma-separated exact IDs, no wildcard.
OAUTH_ALLOWED_SUBJECTS=auth0|replace_with_your_user_id

# False hides AND blocks all create/update/delete/run tools.
ENABLE_WRITE_TOOLS=false

# Optional: enables WordPress post tools. Use an Application Password.
# WORDPRESS_USERNAME=integration-user
# WORDPRESS_PASSWORD=application-password
